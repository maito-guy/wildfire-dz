# Copy to .env and fill in. .env is git-ignored. Never commit keys.

# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000

# Optional: point at another config file
# WF_CONFIG=config.yaml

# Operator token for write endpoints (approve/reject/cancel/send/reset), header X-Operator-Token.
# Empty = dev mode: endpoints stay open and the API logs a warning. Set it for the demo.
OPERATOR_TOKEN=
